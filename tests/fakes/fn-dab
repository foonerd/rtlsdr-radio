#!/bin/bash
# Stand-in for the DAB decoder: records its arguments one per line, announces the
# audio format on stderr as the real one does, then streams silence.
printf '%s\n' "$@" > /tmp/fake-args-fn-dab
[ "$FAKE_DAB_FAILS" = "1" ] && exit 22
# The decoder of a dongle that delivers nothing waits for ever without a word; one that
# gets samples and no station measures its gain and then, here, does not end by itself
[ "$FAKE_DAB_SILENT" = "1" ] && exec sleep 600
[ "$FAKE_DAB_NO_AUDIO" = "1" ] && { echo "GAIN: 40.2 dB (step 23 of 29), level 30.0 of 127, cut off 0.10%" >&2; exec sleep 600; }
sleep 0.1
echo "PCM: rate=48000 stereo=1 size=3840" >&2
# With FAKE_DAB_SLIDE set, a picture arrives a moment into the programme, written the
# way the real decoder writes one: under its own name, moved into place whole
if [ -n "$FAKE_DAB_SLIDE" ]; then
  dir=""; prev=""
  for arg in "$@"; do [ "$prev" = "-i" ] && dir="$arg"; prev="$arg"; done
  ( sleep "$FAKE_DAB_SLIDE"; printf 'label=Now on the stand-in\n' > "${dir}DABlabel.txt"; printf '\377\330picture' > "${dir}slide_0000.jpg.part"; mv "${dir}slide_0000.jpg.part" "${dir}slide_0000.jpg" ) &
fi
while true; do head -c 3840 /dev/zero; sleep 0.02; done
