#!/bin/bash
# Stand-in for the gain tool: records its arguments, counts how often it is run, and
# reports a gain for every frequency it is given, as the real one does. Asked for a
# band (-b) it prints a survey the real one made of recordings of the FM band.
echo "$@" > /tmp/fake-args-fn-rtl-gain
echo x >> /tmp/fake-runs-fn-rtl-gain
# Waiting in a way that ends with this script: a sleep left behind would hold its output open
sleep "${FAKE_GAIN_SECONDS:-0.05}" &
trap 'kill $! 2>/dev/null; exit 143' TERM INT
wait $!
trap - TERM INT
[ "$FAKE_GAIN_FAILS" = "1" ] && { echo "fn-rtl-gain: cannot open device 0" >&2; exit 1; }
if [ "$1" = "-b" ]; then
  cat "$(dirname "$0")/../fixtures/${FAKE_SURVEY:-fm-survey.txt}"
  exit 0
fi
n=0; prev=""
for arg in "$@"; do
  if [ "$prev" = "-f" ]; then n=$((n+1)); echo "GAIN: freq=$arg gain=37.2 step=21 of=29 level=31.0 cut=0.10 backoff=${FAKE_GAIN_BACKOFF:-0.0}"; fi
  prev="$arg"
done
[ $n -gt 1 ] && echo "BAND: gain=37.2 step=21 of=29"
exit 0
