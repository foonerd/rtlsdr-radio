#!/bin/bash
# Stand-in for the FM receiver: a steady stream of silence on stdout.
echo "$@" > /tmp/fake-args-fn-rtl_fm
# With FAKE_FM_SILENT set, the receiver of a dongle that delivers nothing: it runs and
# gives no signal
[ "$FAKE_FM_SILENT" = "1" ] && exec sleep 600
while true; do head -c 6840 /dev/zero; sleep 0.02; done
